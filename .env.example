# Omni Fashion client configuration
#
# Expo exposes EXPO_PUBLIC_* values inside the compiled client bundle.
# Never put private server secrets, AI provider secret keys, service-account
# credentials, private signing keys, or admin tokens in this file.
#
# Copy this file to .env for local development and fill the Firebase Web/App
# config values from the Firebase project used for that environment.

EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Provisional EU default. Final production region is fixed when the real
# Firebase project/Functions deployment is created.
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Later additions, only when implemented:
# EXPO_PUBLIC_WEATHER_PROVIDER=
# EXPO_PUBLIC_ANALYTICS_ENABLED=false
